/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'sha256-J7Va4FlAf5KpCsWNMyrZcDZ4n3RviiLUQw5wBOgAf54='; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Vite content-hashes everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed: rename the file if the font is ever replaced.
/fonts/*
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

/.well-known/matrix/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json
