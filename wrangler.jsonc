{
  "name": "reilly-asia",
  "compatibility_date": "2025-06-29",
  // Assets serve the site; the Worker only runs first for /infra (proxied
  // handbook) so every other request stays a plain static-asset hit.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/infra", "/infra/*"]
  },
  "routes": [
    {
      "pattern": "reilly.asia",
      "custom_domain": true
    },
    {
      "pattern": "www.reilly.asia",
      "custom_domain": true
    }
  ]
}
